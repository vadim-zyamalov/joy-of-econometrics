\begin_layout Standard
Рассмотрим вывод формулы 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:GARCH-LR"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 приведенный в статье 
\begin_inset CommandInset citation
LatexCommand autocite
key "bollerslev1986generalized"
posttextlist "bollerslev1986generalized прил. A1"
literal "false"

\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
Данное доказательство основано на доказательстве аналогичного факта для ARCH модели,
 приведенного в статье 
\begin_inset CommandInset citation
LatexCommand autocite
key "milhoj1985moment"
literal "false"

\end_inset

.
\end_layout

\end_inset

.
\end_layout

\begin_layout Standard
По построению имеем
\begin_inset Formula 
\begin{align*}
\varepsilon_{t} & =\sqrt{h_{t}}\nu_{t}\\
\nu_{t} & \sim{WN}\!\left(0,1\right)
\end{align*}

\end_inset

Воспользуемся этим для проведения последовательной подстановки
\size small

\begin_inset Formula 
\begin{align*}
h_{t} & =\omega+\sum_{i=1}^{q}\alpha_{i}\varepsilon_{t-i}^{2}+\sum_{i=1}^{p}\beta_{i}h_{t-i}=\\
 & =\omega+\sum_{i=1}^{q}\alpha_{i}h_{t-i}\nu_{t-i}^{2}+\sum_{i=1}^{p}\beta_{i}h_{t-i}=\\
 & =\omega+\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}\left(\omega+\sum_{j=1}^{q}\alpha_{j}\varepsilon_{t-i-j}^{2}+\sum_{j=1}^{p}\beta_{j}h_{t-i-j}\right)+\sum_{i=1}^{p}\beta_{i}\left(\text{---\texttt{"}---}\right)=\\
 & =\omega+\omega\left(\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}+\sum_{i=1}^{p}\beta_{i}\right)+\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}\underbrace{\left(\sum_{j=1}^{q}\alpha_{j}\varepsilon_{t-i-j}^{2}+\sum_{j=1}^{p}\beta_{j}h_{t-i-j}\right)}_{\Psi(t-i)}+\sum_{i=1}^{p}\beta_{i}\left(\text{---\texttt{"}---}\right)=\bigast
\end{align*}

\end_inset


\size default
Если ввести обозначения
\begin_inset Formula 
\begin{align*}
M\!\left(t,0\right) & =1,\enspace\forall t\\
M\!\left(t,1\right) & =\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}+\sum_{i=1}^{p}\beta_{i}=\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}M\!\left(t-i,0\right)+\sum_{i=1}^{p}\beta_{i}M\!\left(t-i,0\right)
\end{align*}

\end_inset

то можно увидеть,
 что
\begin_inset Formula 
\begin{align*}
\bigast & =\omega M\!\left(t,0\right)+\omega M\!\left(t,1\right)+{\underbrace{\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}\Psi\!\left(t-i\right)+\sum_{i=1}^{p}\beta_{i}\Psi\!\left(t-i\right)}_{\Phi(t)}}=\bigast
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Рассмотрим последнее слагаемое
\begin_inset Formula 
\begin{align*}
\Psi\!\left(t-i\right) & =\sum_{j=1}^{q}\alpha_{i}\varepsilon_{t-i-j}^{2}+\sum_{j=1j}^{p}\beta_{i}h_{t-i-j}=\\
 & =\sum_{j=1}^{q}\alpha_{j}h_{t-i-j}\nu_{t-i-j}^{2}+\sum_{j=1}^{p}\beta_{j}h_{t-i-j}=\\
 & =\sum_{j=1}^{q}\alpha_{j}\nu_{t-i-j}^{2}\left(\omega+\sum_{k=1}^{q}\alpha_{k}\varepsilon_{t-i-j-k}^{2}+\sum_{k=1}^{p}\beta_{k}h_{t-i-j-k}\right)+\sum_{j=1}^{p}\beta_{j}\left(\text{---\texttt{"}---}\right)=\\
 & =\omega\sum_{j=1}^{q}\alpha_{j}\nu_{t-i-j}^{2}+\\
 & \qquad+\sum_{j=1}^{q}\alpha_{j}\nu_{t-i-j}^{2}\left(\sum_{k=1}^{q}\alpha_{k}\varepsilon_{t-i-j-k}^{2}+\sum_{k=1}^{p}\beta_{k}h_{t-i-j-k}\right)+\omega\sum_{j=1}^{p}\beta_{j}+\sum_{j=1}^{p}\beta_{j}\left(\text{---\texttt{"}---}\right)=\\
 & =\omega M\!\left(t-i,1\right)+\sum_{j=1}^{q}\alpha_{j}\nu_{t-i-j}^{2}\Psi\!\left(t-i-j\right)+\sum_{j=1}^{p}\beta_{j}\Psi\!\left(t-i-j\right)
\end{align*}

\end_inset

Получим отсюда
\begin_inset Formula 
\begin{multline*}
\Phi\!\left(t\right)=\omega\underbrace{\left(\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}M\!\left(t-i,1\right)+\sum_{i=1}^{q}\beta_{i}M\!\left(t-i,1\right)\right)}_{M(t,2)}+\\
+\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}\left(\sum_{j=1}^{q}\alpha_{j}\nu_{t-i-j}^{2}\Psi\!\left(t-i-j\right)+\sum_{j=1}^{p}\beta_{j}\Psi\!\left(t-i-j\right)\right)+\sum_{i=1}^{q}\beta_{i}\left(\text{---\texttt{"}---}\right)
\end{multline*}

\end_inset

Итого
\begin_inset Formula 
\[
\bigast=\omega M\!\left(t,0\right)+\omega M\!\left(t,1\right)+\omega M\!\left(t,2\right)+\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}\Phi\!\left(t-i\right)+\sum_{i=1}^{q}\beta_{i}\Phi\!\left(t-i\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Очевидно,
 что выражение для 
\begin_inset Formula $\Phi$
\end_inset

 описывается следующим рекуррентным выражением
\begin_inset Formula 
\begin{equation}
\Phi\!\left(\tau\right)=\omega M\!\left(\tau,2\right)+\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}\Phi\!\left(\tau-i\right)+\sum_{i=1}^{q}\beta_{i}\Phi\!\left(\tau-i\right),\label{eq:Phi-rec}
\end{equation}

\end_inset

которое,
 если ввести соотношение 
\begin_inset Formula $M\!\left(t,k\right)=\sum_{i=1}^{q}\alpha_{i}\nu_{t-i}^{2}M\!\left(t-i,k-1\right)+\sum_{i=1}^{p}\beta_{i}M\!\left(t-i,k-1\right)$
\end_inset

,
 приводит к тому,
 что при бесконечном повторении таких подстановок
\begin_inset Formula 
\[
h_{t}=\omega\sum_{i=0}^{\infty}M\!\left(t,i\right)
\]

\end_inset

Действительно,
 при первой подстановке 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Phi-rec"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 в 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Phi-rec"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 мы получим 
\series bold
два
\series default
 значения 
\begin_inset Formula $M\!\left(\tau-i,2\right)$
\end_inset

,
 которые сольются в 
\begin_inset Formula $M\!\left(\tau,3\right)$
\end_inset

;
 помимо этого в выражении появятся 
\series bold
четыре
\series default
 слагаемых с 
\begin_inset Formula $\Phi\!\left(\tau-i-j\right)$
\end_inset

,
 обернутых в такие суммы,
 что 
\series bold
четыре
\series default
 значения 
\begin_inset Formula $M\!\left(\tau-i-j,2\right)$
\end_inset

 сначала сольются в 
\series bold
два
\series default
 значения 
\begin_inset Formula $M\!\left(\tau-i,3\right)$
\end_inset

,
 которые дадут нам 
\begin_inset Formula $M\!\left(\tau,4\right)$
\end_inset

.
 При этом в выражении появятся 
\series bold
восемь
\series default
 слагаемых с 
\begin_inset Formula $\Phi\!\left(\tau-i-j-k\right)$
\end_inset

,
 дающих 
\series bold
восемь
\series default
 значений 
\begin_inset Formula $M\!\left(\tau-i-j-k,2\right)\Rightarrow M\!\left(\tau,5\right)$
\end_inset

 и 
\series bold
шестнадцать
\series default
 слагаемых с 
\begin_inset Formula $\Phi\!\left(\tau-i-j-k-l\right)$
\end_inset

,
 и так далее.
 На каждом шаге циклической подстановки мы будем получать 
\begin_inset Formula $2^{\lambda}$
\end_inset

 значения 
\begin_inset Formula $M\!\left(t-S,2\right)\Rightarrow M\!\left(t,\lambda+2\right)$
\end_inset

 и 
\begin_inset Formula $2^{\lambda+1}$
\end_inset

 слагаемое с 
\begin_inset Formula $\Phi\!\left(t-S-i\right)$
\end_inset

.
\end_layout

\begin_layout Standard
В силу того,
 что 
\begin_inset Formula $\nu_{t}$
\end_inset

 —
 белый шум,
\begin_inset Formula 
\[
\E M\!\left(t,k\right)=\E M\!\left(s,k\right),\enspace\forall t,s,
\]

\end_inset

то есть
\begin_inset Formula 
\begin{align*}
\E M\!\left(t,k\right) & =\left(\sum_{i=1}^{q}\alpha_{i}+\sum_{i=1}^{p}\beta_{i}\right)\E M\!\left(t,k-1\right)=\\
 & =\left(\sum_{i=1}^{q}\alpha_{i}+\sum_{i=1}^{p}\beta_{i}\right)^{2}\E M\!\left(t,k-2\right)=\\
 & =\left(\sum_{i=1}^{q}\alpha_{i}+\sum_{i=1}^{p}\beta_{i}\right)^{3}\E M\!\left(t,k-3\right)=\\
 & \vdots\\
 & =\left(\sum_{i=1}^{q}\alpha_{i}+\sum_{i=1}^{p}\beta_{i}\right)^{k}
\end{align*}

\end_inset

Отсюда
\begin_inset Formula 
\begin{align*}
\E\varepsilon_{t}^{2}=\E h_{t} & =\omega\sum_{i=0}^{\infty}\E M\!\left(t,i\right)=\\
 & =\omega\sum_{i=0}^{\infty}\left(\sum_{i=1}^{q}\alpha_{i}+\sum_{i=1}^{p}\beta_{i}\right)^{i}=\\
 & =\frac{\omega}{1-\sum_{i=1}^{q}\alpha_{i}-\sum_{i=1}^{p}\beta_{i}}
\end{align*}

\end_inset

если 
\begin_inset Formula $\sum_{i=1}^{q}\alpha_{i}+\sum_{i=1}^{p}\beta_{i}<1$
\end_inset

.
\end_layout

