\begin_layout Standard
First,
 from
\begin_inset space ~
\end_inset


\begin_inset CommandInset citation
LatexCommand autocite
key "gentle2017matrix,magnus2019matrix"
literal "false"

\end_inset

 we know,
 that 
\begin_inset Formula 
\begin{gather*}
\dd f=\tr\left[\left(\frac{df}{dA}\right)'\dd A\right]\\
\dd f=\dd\left(\tr f\right)=\tr\left(\dd f\right)
\end{gather*}

\end_inset

where 
\begin_inset Formula $\tr$
\end_inset

 is the trace function,
 i.e.
\begin_inset space ~
\end_inset

the sum of the diagonal elements of a matrix,
 
\begin_inset Formula $A$
\end_inset

 is a matrix,
 
\begin_inset Formula $f$
\end_inset

 is a scalar function.
\end_layout

\begin_layout Standard
We have 
\begin_inset Formula 
\[
f=\sum^{T}_{t=1}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Using the following properties of differential and trace 
\begin_inset Formula 
\begin{gather*}
\dd A=\left(\dd a_{ij}\right)\\
\dd\left(AB\right)=\dd A\,B+A\,\dd B\\
\dd\tr A=\tr\left(\dd A\right)\\
\dd A'=\left(\dd A\right)'\\
\tr A=\tr A'\\
\tr\left(AB\right)=\tr\left(BA\right)\\
\tr\left(A+B\right)=\tr A+\tr B
\end{gather*}

\end_inset

we get the following chain of expressions 
\begin_inset Formula 
\[
\begin{aligned}\dd f & =\tr\left(\dd\sum^{T}_{t=1}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right)=\\
 & =\tr\sum^{T}_{t=1}\dd\left[\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]=\\
 & =\sum^{T}_{t=1}\tr\dd\left[\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]=\\
 & =\sum^{T}_{t=1}\tr\left[\dd\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)+\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\dd\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]=\\
 & =-\sum^{T}_{t=1}\tr\left[\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)+\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]=\\
 & =-\sum^{T}_{t=1}\left\{ \tr\left[\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]+\tr\left[\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]\right\} =\\
 & =-\sum^{T}_{t=1}\left\{ \tr\left[\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]+\tr\left[\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]\right\} =\\
 & =-2\tr\left[\sum^{T}_{t=1}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]=\bigast
\end{aligned}
\]

\end_inset

Here we use 
\begin_inset Formula $\bigast$
\end_inset

 to mark the break in the expression chain.
\end_layout

\begin_layout Standard
To proceed,
 let's simplify the differential inside the sum 
\begin_inset Formula 
\[
\begin{aligned}\dd\left(\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right) & =\dd\Vect{\Psi}_{t}'\left(\Vect B'\Vect x_{t}\right)+\Vect{\Psi}_{t}'\dd\left(\Vect B'\Vect x_{t}\right)=\\
 & =\Vect{\Psi}_{t}'\left(\dd\Vect B'\Vect x_{t}+\Vect B'\dd\Vect x_{t}\right)=\\
 & =\Vect{\Psi}_{t}'\dd\Vect B'\,\Vect x_{t}.
\end{aligned}
\]

\end_inset

For every 
\begin_inset Formula $t$
\end_inset

 we can consider 
\begin_inset Formula $\Vect{\Psi}_{t}$
\end_inset

 and 
\begin_inset Formula $\Vect x_{t}$
\end_inset

 as constants,
 hence their differentials are zero.
\end_layout

\begin_layout Standard
With that,
 we get 
\begin_inset Formula 
\[
\begin{aligned}\bigast & =-2\tr\left[\sum^{T}_{t=1}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\Vect{\Psi}_{t}'\dd\Vect B'\Vect x_{t}\right]=\\
 & =-2\tr\left[\sum^{T}_{t=1}\Vect x_{t}'\dd\Vect B_{t}\:\Vect{\Psi}_{t}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\right]=\bigast
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Standard
From 
\begin_inset Formula $\tr\left(AB\right)=\tr\left(BA\right)$
\end_inset

 it follows that 
\begin_inset Formula $\tr\left(A_{1}A_{2}\dots A_{n}\right)=\tr\left(A_{n}A_{1}\dots A_{n-1}\right)$
\end_inset

.
 Then we have 
\begin_inset Formula 
\[
\begin{aligned}\bigast & =-2\tr\left[\sum^{T}_{t=1}\Vect{\Psi}_{t}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\Vect x_{t}'\dd\Vect B\right]=\\
 & =\tr\left\{ \left[-2\sum^{T}_{t=1}\Vect{\Psi}_{t}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\Vect x_{t}'\right]\dd\Vect B\right\} .
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Standard
Hence,
 we get 
\begin_inset Formula 
\[
\frac{df}{d\Vect B}=\left[-2\sum^{T}_{t=1}\Vect{\Psi}_{t}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)\Vect x_{t}'\right]'=-2\sum^{T}_{t=1}\Vect x_{t}\left(\Vect y_{t}-\Vect{\Psi}_{t}'\Vect B'\Vect x_{t}\right)'\Vect{\Psi}_{t}'
\]

\end_inset


\end_layout

\begin_layout Section
Вывод
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:nls-3"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset


\end_layout

\begin_layout Standard
Let's go back to 
\begin_inset Formula 
\[
\vecc\hat{\Vect B}=\left[T^{-1}\sum^{T}_{t=1}\left(\Vect{\Psi}_{t}\Vect{\Psi}_{t}'\right)\otimes\left(\Vect x_{t}\Vect x_{t}'\right)\right]^{-1}\left[T^{-1}\sum^{T}_{t=1}\vecc\left(\Vect x_{t}\Vect y_{t}'\Vect{\Psi}_{t}'\right)\right]=\bigast
\]

\end_inset


\end_layout

\begin_layout Standard
From
\begin_inset space ~
\end_inset


\begin_inset CommandInset citation
LatexCommand autocite
key "gentle2017matrix"
literal "false"

\end_inset

 we can get the following properties of Kronecker product 
\begin_inset Formula 
\begin{gather*}
\left(A\otimes B\right)'=A'\otimes B'\\
\left(A\otimes B\right)\left(C\otimes D\right)=\left(AC\right)\otimes\left(BD\right)\\
\vecc\left(ABC\right)=\left(C'\otimes A\right)\vecc B
\end{gather*}

\end_inset

The corresponding matrix products should exist.
\end_layout

\begin_layout Standard
Then we have 
\begin_inset Formula 
\[
\bigast=\left[T^{-1}\sum^{T}_{t=1}\left(\Vect{\Psi}_{t}\otimes\Vect x_{t}\right)\left(\Vect{\Psi}_{t}'\otimes\Vect x_{t}'\right)\right]^{-1}\left[T^{-1}\sum^{T}_{t=1}\left(\Vect{\Psi}_{t}\otimes\Vect x_{t}\right)\vecc\Vect x_{t}'\right]=\bigast
\]

\end_inset


\end_layout

\begin_layout Standard
As 
\begin_inset Formula $\Vect y_{t}$
\end_inset

 is already a vector then 
\begin_inset Formula $\vecc\Vect y_{t}'=\vecc\Vect y_{t}$
\end_inset

.
 Hence we have 
\begin_inset Formula 
\[
\begin{aligned}\bigast & =\left[\sum^{T}_{t=1}\left(\Vect{\Psi}_{t}\otimes\Vect x_{t}\right)\left(\Vect{\Psi}_{t}'\otimes\Vect x_{t}'\right)\right]^{-1}\left[\sum^{T}_{t=1}\left(\Vect{\Psi}_{t}\otimes\Vect x_{t}\right)\vecc\Vect y_{t}\right]=\\
 & =\left[\sum^{T}_{t=1}\Upsilon_{t}\Upsilon_{t}'\right]^{-1}\left[\sum^{T}_{t=1}\Upsilon_{t}\vecc\Vect y_{t}\right]
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Standard
Setting 
\begin_inset Formula $M=\left(\Upsilon_{1},\Upsilon_{2},\dots,\Upsilon_{T}\right)'$
\end_inset

 we can see that 
\begin_inset Formula 
\[
\sum^{T}_{t=1}\Upsilon_{t}\Upsilon_{t}'=M'M
\]

\end_inset

Setting 
\begin_inset Formula $\Vect Y=\left(\Vect y_{1}',\dots,\Vect y_{Y}'\right)'$
\end_inset

 we can get 
\begin_inset Formula 
\[
\sum^{T}_{t=1}\Upsilon_{t}\vecc\Vect y_{t}=M'\vecc\left(\Vect Y'\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Hence,
 we get
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:nls-3"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

.
\end_layout

