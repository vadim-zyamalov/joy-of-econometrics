\bar{\Vect K}=\begin{bmatrix}\vecc[\partial(\bar{\Vect{\Psi}}'_{1}\bar{\Vect B}'\Vect x_{1})/\partial\theta]'\\
\vecc[\partial(\bar{\Vect{\Psi}}'_{2}\bar{\Vect B}'\Vect x_{2})/\partial\theta]'\\
\vdots\\
\vecc[\partial(\bar{\Vect{\Psi}}'_{T}\bar{\Vect B}'\Vect x_{T})/\partial\theta]'
