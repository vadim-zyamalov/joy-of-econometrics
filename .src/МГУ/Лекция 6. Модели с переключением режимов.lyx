\begin_inset CommandInset citation
LatexCommand autocite
key "vandijk2000smooth"
literal "false"

\end_inset

 
\begin_inset Formula 
\begin{align}
y_{t} & =\sum^{M}_{i=1}\left[G_{i}(s_{t})-G_{i+1}(s_{t})\right]\underbrace{\left(a_{i0}+\sum^{p}_{j=1}a_{ij}y_{t-j}\right)}_{a_{i}'x_{t}}+\varepsilon_{t}\label{star-multi}\\
G_{i}\left(s_{t}\right) & \coloneq G\left(s_{t};\gamma,c\right)\nonumber \\
G_{1} & =1\iff c_{1}\rightarrow-\infty\nonumber \\
G_{M+1} & =0\iff c_{M+1}\rightarrow\infty\nonumber \\
a_{i} & =\left(a_{i0},a_{i1},a_{i2},\dots\right)'\nonumber \\
x_{t} & =\left(1,y_{t-1},y_{t-2},\dots\right)'\nonumber 
\end{align}

\end_inset

или 
\begin_inset Formula 
\begin{equation}
y_{t}=a'_{1}x_{t}+\left(a'_{2}-a'_{1}\right)x_{t}G\left(s_{t};\gamma_{2},c_{2}\right)+\dots+\left(a'_{M}-a'_{M-1}\right)x_{t}G\left(s_{t};\gamma_{M},c_{M}\right)+\varepsilon_{t}\label{star-multi-2}
\end{equation}

\end_inset


