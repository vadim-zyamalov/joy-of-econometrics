.
\end_layout

\begin_deeper
\begin_layout Standard
Также постойте матрицы 
\begin_inset Formula 
\[
\bar{\Vect Z}=\begin{bmatrix}\vecc(\bar{\Vect{\Psi}}_{1}\otimes\Vect x_{1}\tau_{1})'\\
\vecc(\bar{\Vect{\Psi}}_{2}\otimes\Vect x_{2}\tau_{2})'\\
\vdots\\
\vecc(\bar{\Vect{\Psi}}_{T}\otimes\Vect x_{T}\tau_{T})'
