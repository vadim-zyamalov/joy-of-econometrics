 & \frac{1}{2} &  &  &  & 1 &  &  &  & \frac{1}{2}\\
 &  & \frac{1}{2} &  &  &  & 1 &  &  &  & \frac{1}{2}\\
 &  &  & \frac{1}{2} &  &  &  & 1 & 0 &  &  & 0\\
\hline  &  &  &  & \frac{1}{2} &  &  &  & 1\\
 &  &  &  &  & \frac{1}{2} &  &  &  & 1\\
 &  &  &  &  &  & \frac{1}{2} &  &  &  & 1\\
 &  &  &  &  &  &  & \frac{1}{2} &  &  &  & 0
\end{array}\end{pmatrix},\\
\tilde{D}_{12} & =\begin{pmatrix}\begin{array}{cccc|cccc|cccc}
1 &  &  &  & \frac{1}{2} &  &  & \\
 & 1 &  &  &  & \frac{1}{2} &  & \\
 &  & 1 &  &  &  & \frac{1}{2} & \\
 &  &  & 1 &  &  &  & \frac{1}{2}\\
\hline \frac{1}{2} &  &  &  & 1 &  &  &  & \frac{1}{2}\\
 & \frac{1}{2} &  &  &  & 1 &  &  &  & \frac{1}{2}\\
 &  & \frac{1}{2} &  &  &  & 1 &  &  &  & \frac{1}{2}\\
