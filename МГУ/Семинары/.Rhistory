library(quantmod)
getSymbols("AAPL", from="2020/01/01", to="2024/12/31", periodicity="daily")
apple_r <- log(AAPL$AAPL.Adjusted / Lag(AAPL$AAPL.Adjusted, 1))
apple_r <- na.omit(apple_r)
e <- rnorm(300, sd = .1)
x <- numeric(300)
tau <- (1:300)/300
beta <- 0.9 * cos(tau)
for (t in 2:300) {
x[t] <- beta[t] * x[t-1] + e[t]
}
pacf(x)
arima(x, order = c(1, 0, 0), include.mean = FALSE)
mod.tvAR <- tvReg::tvAR(x, p = 1, type = "none")
plot(mod.tvAR$coefficients, type = "l")
lines(beta, col="red")
summary(mod.tvAR)
