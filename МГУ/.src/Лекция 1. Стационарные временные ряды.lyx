\end_inset

Найдем первую автокорреляцию:
 
\begin_inset Formula 
\[
\begin{aligned}\E{y_{t}\varepsilon_{t}} & =\E{\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\varepsilon_{t}}=\\
 & =a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t}}}_{=0}}+{\underbrace{\E\varepsilon_{t}^{2}}_{=\sigma^{2}}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t}}}_{=0}}=\sigma^{2}
\end{aligned}
\]

\end_inset


\begin_inset Formula 
\[
\begin{aligned}\E{y_{t}\varepsilon_{t-1}} & =\E{\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\varepsilon_{t-1}}=\\
 & =a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-1}}}_{=\sigma^{2}}}+{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-1}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-1}}}_{=\sigma^{2}}}=\left(a_{1}+\beta_{1}\right)\sigma^{2}
\end{aligned}
\]

\end_inset


\begin_inset Formula 
\[
\begin{aligned}\gamma_{0}=\E y_{t}^{2} & =\E{(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1})}^{2}=\\
 & =a_{1}^{2}{\underbrace{\E y_{t-1}^{2}}_{=\gamma_{0}}}+a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t}}}_{=0}}+a_{1}\beta_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-1}}}_{=\sigma^{2}}}+\\
 & \phantom{=}+a_{1}{\underbrace{\E{\varepsilon_{t}y_{t-1}}}_{=0}}+{\underbrace{\E\varepsilon_{t}^{2}}_{=\sigma^{2}}}+\beta_{1}{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-1}}}_{=0}}+\\
 & \phantom{=}+a_{1}\beta_{1}{\underbrace{\E{\varepsilon_{t-1}y_{t-1}}}_{=\sigma^{2}}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t}}}_{=0}}+\beta_{1}^{2}{\underbrace{\E\varepsilon_{t-1}^{2}}_{=\sigma^{2}}}\Rightarrow\\
\Rightarrow\gamma_{0} & =\frac{1+\beta_{1}^{2}+2a_{1}\beta_{1}}{1-a_{1}^{2}}\sigma^{2}
\end{aligned}
\]

\end_inset


\begin_inset Formula 
\[
\begin{aligned}\gamma_{1}=\E{y_{t}y_{t-1}} & =\E\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\left(a_{1}y_{t-2}+\varepsilon_{t-1}+\beta_{1}\varepsilon_{t-2}\right)=\\
 & =a_{1}^{2}{\underbrace{\E{y_{t-1}y_{t-2}}}_{=\gamma_{1}}}+a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-1}}}_{=\sigma^{2}}}+a_{1}\beta_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-2}}}_{=(a_{1}+\beta_{1})\sigma^{2}}}+\\
 & \phantom{=}+a_{1}{\underbrace{\E{\varepsilon_{t}y_{t-2}}}_{=0}}+{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-1}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-2}}}_{=0}}+\\
 & \phantom{=}+a_{1}\beta_{1}{\underbrace{\E{\varepsilon_{t-1}y_{t-2}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-1}}}_{=\sigma^{2}}}+\beta_{1}^{2}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-2}}}_{=0}}=\\
 & =a_{1}^{2}\gamma_{1}+\left[a_{1}+a_{1}\beta_{1}\left(a_{1}+\beta_{1}\right)+\beta_{1}\right]\sigma^{2}\Rightarrow\\
\Rightarrow\gamma_{1} & =\frac{\left(1+a_{1}\beta_{1}\right)\left(a_{1}+\beta_{1}\right)}{1-a_{1}^{2}}\\
\rho_{1} & =\frac{\left(1+a_{1}\beta_{1}\right)\left(a_{1}+\beta_{1}\right)}{1+\beta_{1}^{2}+2a_{1}\beta_{1}}
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Enumerate
Найдем вторую автокорреляцию.
 
\begin_inset Formula 
\[
\begin{aligned}\E{y_{t}\varepsilon_{t-2}} & =\E{\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\varepsilon_{t-2}}=\\
 & =a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-2}}}_{=(a_{1}+\beta_{1})\sigma^{2}}}+{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-2}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-2}}}_{=0}}=a_{1}\left(a_{1}+\beta_{1}\right)\sigma^{2}
\end{aligned}
\]

\end_inset


\begin_inset Formula 
\[
\begin{aligned}\gamma_{2}=\E{y_{t}y_{t-2}} & =\E\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\left(a_{1}y_{t-3}+\varepsilon_{t-2}+\beta_{1}\varepsilon_{t-3}\right)=\\
 & =a_{1}^{2}{\underbrace{\E{y_{t-1}y_{t-3}}}_{=\gamma_{2}}}+a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-2}}}_{=(a_{1}+\beta_{1})\sigma^{2}}}+a_{1}\beta_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-3}}}_{=a_{1}(a_{1}+\beta_{1})\sigma^{2}}}+\\
 & \phantom{=}+a_{1}{\underbrace{\E{\varepsilon_{t}y_{t-3}}}_{=0}}+{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-2}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-3}}}_{=0}}+\\
 & \phantom{=}+a_{1}\beta_{1}{\underbrace{\E{\varepsilon_{t-1}y_{t-3}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-2}}}_{=0}}+\beta_{1}^{2}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-3}}}_{=0}}=\\
 & =a_{1}^{2}\gamma_{2}+\left[a_{1}\left(a_{1}+\beta_{1}\right)+a_{1}^{2}\beta_{1}\left(a_{1}+\beta_{1}\right)\right]\sigma^{2}\Rightarrow\\
\Rightarrow\gamma_{2} & =\frac{\left(1+a_{1}\beta_{1}\right)\left(a_{1}+\beta_{1}\right)}{1-a_{1}^{2}}\\
\rho_{2} & =\frac{a_{1}\left(1+a_{1}\beta_{1}\right)\left(a_{1}+\beta_{1}\right)}{1+\beta_{1}^{2}+2a_{1}\beta_{1}}=a_{1}\rho_{1}
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Enumerate
Найдем третью автокорреляцию.
 
\begin_inset Formula 
\[
\begin{aligned}\E{y_{t}\varepsilon_{t-3}} & =\E{\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\varepsilon_{t-3}}=\\
 & =a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-3}}}_{=a_{1}(a_{1}+\beta_{1})\sigma^{2}}}+{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-3}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-3}}}_{=0}}=a_{1}^{2}\left(a_{1}+\beta_{1}\right)\sigma^{2}
\end{aligned}
\]

\end_inset


\begin_inset Formula 
\[
\begin{aligned}\gamma_{3}=\E{y_{t}y_{t-3}} & =\E{\left(a_{1}y_{t-1}+\varepsilon_{t}+\beta_{1}\varepsilon_{t-1}\right)\left(a_{1}y_{t-4}+\varepsilon_{t-3}+\beta_{1}\varepsilon_{t-4}\right)}=\\
 & =a_{1}^{2}{\underbrace{\E{y_{t-1}y_{t-4}}}_{=\gamma_{3}}}+a_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-3}}}_{=a_{1}(a_{1}+\beta_{1})\sigma^{2}}}+a_{1}\beta_{1}{\underbrace{\E{y_{t-1}\varepsilon_{t-4}}}_{=a_{1}^{2}(a_{1}+\beta_{1})\sigma^{2}}}+\\
 & \phantom{=}+a_{1}{\underbrace{\E{\varepsilon_{t}y_{t-4}}}_{=0}}+{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-3}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t}\varepsilon_{t-4}}}_{=0}}+\\
 & \phantom{=}+a_{1}\beta_{1}{\underbrace{\E{\varepsilon_{t-1}y_{t-4}}}_{=0}}+\beta_{1}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-3}}}_{=0}}+\beta_{1}^{2}{\underbrace{\E{\varepsilon_{t-1}\varepsilon_{t-4}}}_{=0}}=\\
 & =a_{1}^{2}\gamma_{3}+\left[a_{1}^{2}\left(a_{1}+\beta_{1}\right)+a_{1}^{3}\beta_{1}\left(a_{1}+\beta_{1}\right)\right]\sigma^{2}\Rightarrow\\
\Rightarrow\gamma_{3} & =\frac{a_{1}^{2}\left(1+a_{1}\beta_{1}\right)\left(a_{1}+\beta_{1}\right)}{1-a_{1}^{2}}\\
\rho_{3} & =\frac{a_{1}^{2}\left(1+a_{1}\beta_{1}\right)\left(a_{1}+\beta_{1}\right)}{1+\beta_{1}^{2}+2a_{1}\beta_{1}}=a_{1}^{2}\rho_{1}
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Standard
Нетрудно показать,
 что 
\begin_inset Formula 
\[
\rho_{s}=a_{1}^{s-1}\rho_{1}
\]

