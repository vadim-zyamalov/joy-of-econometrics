	pages = {307--327},
	date = {1986-04},
	abstract = {A natural generalization of the ARCH (Autoregressive Conditional
	            Heteroskedastic) process introduced in Engle (1982) to allow for
	            past conditional variances in the current conditional variance
	            equation is proposed. Stationarity conditions and autocorrelation
