	author = {Petruccelli, Joseph D. and Woolford, Samuel W.},
	year = 1984,
	journal = {Journal of Applied Probability},
	publisher = {{Cambridge University Press}},
	volume = 21,
	number = 2,
	pages = {270--286},
	abstract = {We consider the model Zt={$\varphi$}1Zt-1 ++{$\varphi$}2Zt-1 -
	            +at where {$\varphi$}1, {$\varphi$}2 are real coefficients, not
	            necessarily equal, and the at's are a sequence of i.i.d. random
	            variables with mean 0. Necessary and sufficient conditions on the
	            {$\varphi$}'s are given for stationarity of the process. Least
	            squares estimators of the {$\varphi$}'s are derived and, under
	            mild regularity conditions, are shown to be consistent and
	            asymptotically normal. An hypothesis test is given to
	            differentiate between an AR(1) (the case {$\varphi$}1={$\varphi$}
	            2) and this threshold model. The asymptotic behavior of the test
	            statistic is derived. Small-sample behavior of the estimators and
	            the hypothesis test are studied via simulated data.},
